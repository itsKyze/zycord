# ==============================================================================
# ZYCORD CORE CONFIGURATION
# ==============================================================================
DOMAIN=app.yourdomain.com
INSTANCE_NAME=Zycord
POSTGRES_PASSWORD=change_me_strong_password

# WebRTC Voice & Video SFU
# Enter the public IP of the external device (curl https://api.ipify.org)
WRTC_PUBLIC_IP=0.0.0.0
WRTC_PORT=50000

# Networking & Reverse Proxy
# caddy = Use the built-in Caddy | Leave blank if you have an external Nginx
COMPOSE_PROFILES=caddy
CADDY_GLOBAL_OPTIONS="email admin@yourdomain.com"
SERVER_PORT=3001
# uniquelocal = Read the real IP from Caddy via Docker bridge
TRUSTED_PROXIES=uniquelocal

# Version & Revision (leave blank or provide a commit hash)
REVISION=
REVISION_TIME=

# Server Performance & Logging
CLIENT_CONCURRENCY=8
LOG_REQUESTS=500,501

# ==============================================================================
# E2EE RECOVERY
# ==============================================================================
E2EE_RECOVERY_KEY_FILE=/data/state/.e2ee-recovery.key
# Key generation: openssl rand -hex 32
E2EE_RECOVERY_MASTER_KEY=

# ==============================================================================
# CAPTCHA SETTINGS (hCaptcha)
# Get the keys from: https://dashboard.hcaptcha.com
# ==============================================================================
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ==============================================================================
# SMTP EMAIL SETTINGS
# Resend example: https://resend.com
# ==============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ==============================================================================
# OAUTH CONNECTIONS & INTEGRATIONS
# Callback URL for all platforms: https://${DOMAIN}/connections/<platform>
# ==============================================================================

# --- GitHub ---
# Portal: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Spotify ---
# Portal: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Twitch ---
# Portal: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube / Google ---
# Portal: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Twitter / X ---
# Portal: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Reddit ---
# Portal: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Battle.net ---
# Portal: https://develop.battle.net/access/clients
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# --- Epic Games ---
# Portal: https://dev.epicgames.com/portal
EPICGAMES_CLIENT_ID=
EPICGAMES_CLIENT_SECRET=

# --- Xbox ---
# Portal: https://portal.azure.com
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# --- Facebook ---
# Portal: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Steam ---
# Portal: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
