# ==============================================================================
# ZYCORD CORE CONFIGURATION
# ==============================================================================
DOMAIN=app.zyron.site
INSTANCE_NAME=Zycord
POSTGRES_PASSWORD=change-me

# WebRTC Voice & Video SFU
WRTC_PUBLIC_IP=203.0.113.10
WRTC_PORT=50000

# Networking & Reverse Proxy
# (the bundled caddy service; leave empty to use your own reverse proxy on 127.0.0.1:SERVER_PORT instead)
COMPOSE_PROFILES=caddy
CADDY_GLOBAL_OPTIONS=
SERVER_PORT=3001
TRUSTED_PROXIES=

# Captcha Settings
CAP_INSTANCE_URL=
CAP_SITE_KEY=
CAP_SECRET_KEY=

# SMTP Email Settings
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Server Performance & Logging
CLIENT_CONCURRENCY=8
LOG_REQUESTS=500,501
REVISION=
REVISION_TIME=0

# E2EE Recovery
E2EE_RECOVERY_KEY_FILE=
E2EE_RECOVERY_MASTER_KEY=

# ==============================================================================
# OAUTH CONNECTIONS & INTEGRATIONS
# For each platform, create an OAuth app on its developer portal.
# Callback URL for all platforms: https://${DOMAIN}/connections/<platform>
# ==============================================================================

# --- GitHub ---
# Portal: https://github.com/settings/developers
# Callback: https://app.zyron.site/connections/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Spotify ---
# Portal: https://developer.spotify.com/dashboard
# Callback: https://app.zyron.site/connections/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Twitch ---
# Portal: https://dev.twitch.tv/console/apps
# Callback: https://app.zyron.site/connections/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube / Google ---
# Portal: https://console.cloud.google.com/apis/credentials
# Callback: https://app.zyron.site/connections/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Twitter / X ---
# Portal: https://developer.twitter.com/en/portal/dashboard
# Callback: https://app.zyron.site/connections/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Discord ---
# Portal: https://discord.com/developers/applications
# Callback: https://app.zyron.site/connections/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Reddit ---
# Portal: https://www.reddit.com/prefs/apps
# Callback: https://app.zyron.site/connections/reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Battle.net ---
# Portal: https://develop.battle.net/access/clients
# Callback: https://app.zyron.site/connections/battlenet
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# --- Epic Games ---
# Portal: https://dev.epicgames.com/portal
# Callback: https://app.zyron.site/connections/epicgames
EPICGAMES_CLIENT_ID=
EPICGAMES_CLIENT_SECRET=

# --- Xbox ---
# Portal: https://portal.azure.com
# Callback: https://app.zyron.site/connections/xbox
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# --- Facebook ---
# Portal: https://developers.facebook.com/apps
# Callback: https://app.zyron.site/connections/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Steam ---
# Portal: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
