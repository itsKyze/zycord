DOMAIN=app.yourdomain.com
INSTANCE_NAME=Zycord
POSTGRES_PASSWORD=change_me_strong_password

# WebRTC Voice & Video SFU
WRTC_PUBLIC_IP=0.0.0.0
WRTC_PORT=50000

# Networking & Reverse Proxy
COMPOSE_PROFILES=caddy
CADDY_GLOBAL_OPTIONS="email admin@yourdomain.com"
SERVER_PORT=3001
TRUSTED_PROXIES=uniquelocal

# Version & Revision
REVISION=
REVISION_TIME=

# Server Performance & Logging
CLIENT_CONCURRENCY=8
LOG_REQUESTS=500,501

# E2EE Recovery
E2EE_RECOVERY_KEY_FILE=/data/state/.e2ee-recovery.key
E2EE_RECOVERY_MASTER_KEY=

# Captcha Settings (hCaptcha)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# SMTP Email Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# OAuth Connections & Integrations
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube / Google
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitter / X
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Battle.net
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# Epic Games
EPICGAMES_CLIENT_ID=
EPICGAMES_CLIENT_SECRET=

# Xbox
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Steam
STEAM_API_KEY=
