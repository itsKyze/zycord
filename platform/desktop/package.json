{
    "name": "zycord",
    "productName": "Zycord",
    "version": "1.0.11",
    "description": "Zycord",
    "main": "src/main.js",
    "author": {
        "name": "Zyron Solutions Ltd",
        "email": "itsKyze@users.noreply.github.com"
    },
    "homepage": "https://app.zyron.site",
    "license": "AGPL-3.0-only",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "build": "electron-builder --win",
        "build:dir": "electron-builder --win --dir",
        "build:portable": "electron-builder --win portable",
        "dist": "electron-builder --win nsis"
    },
    "build": {
        "appId": "com.zyron.zycord",
        "productName": "Zycord",
        "copyright": "Copyright © 2026 Zyron Solutions Ltd",
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "extraFiles": [
            {
                "from": "assets/Update.exe",
                "to": "Update.exe"
            }
        ],
        "files": [
            "src/**/*",
            "assets/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.ico"
        },
        "linux": {
            "maintainer": "Zyron Solutions Ltd <itsKyze@users.noreply.github.com>",
            "target": [
                "tar.gz",
                "deb",
                "rpm"
            ],
            "icon": "assets/icon.png",
            "category": "Network",
            "artifactName": "Zycord-linux-${arch}.${ext}"
        },
        "mac": {
            "target": [
                "zip"
            ],
            "icon": "assets/icon.png",
            "category": "public.app-category.social-networking",
            "artifactName": "Zycord-macOS.${ext}"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowElevation": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "shortcutName": "Zycord",
            "uninstallDisplayName": "Zycord",
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "include": "installer.nsh",
            "artifactName": "ZycordSetup-${arch}.${ext}"
        },
        "publish": [
            {
                "provider": "generic",
                "url": "https://app.zyron.site/updates/windows/"
            }
        ]
    },
    "devDependencies": {
        "electron": "^32.2.0",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "electron-updater": "^6.3.9"
    }
}
