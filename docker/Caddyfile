{
	{$CADDY_GLOBAL_OPTIONS}
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	@websockets {
		path / /voice /voice/* /remote-auth /remote-auth/*
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @websockets {
		reverse_proxy server:3001 {
			stream_close_delay 5m
		}
	}

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy server:3001
	}
}

docs.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	@notDocs {
		not path /developers/docs /developers/docs/* /docs /docs/* /api/* /assets/* /branding/* /cdn/* /attachments/* /avatars/* /icons/* /banners/* /favicon.* /_mintlify/*
	}
	rewrite @notDocs /developers/docs{uri}
	reverse_proxy server:3001
}

developers.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	@notDev {
		not path /developers /developers/* /api/* /assets/* /branding/* /cdn/* /attachments/* /avatars/* /icons/* /banners/* /emojis/* /stickers/* /imageproxy/* /favicon.* /_mintlify/*
	}
	rewrite @notDev /developers{uri}
	reverse_proxy server:3001
}

admin.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	@notAdmin {
		not path /admin /admin/* /api/* /assets/* /branding/* /cdn/* /attachments/* /avatars/* /icons/* /banners/* /emojis/* /stickers/* /imageproxy/* /favicon.*
	}
	rewrite @notAdmin /admin{uri}
	reverse_proxy server:3001
}

cdn.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	# Official CDN Protection on root
	@root path /
	handle @root {
		header Content-Type application/xml
		respond `<?xml version="1.0" encoding="UTF-8"?>
<Error>
  <Code>AccessDenied</Code>
  <Message>Access Denied</Message>
</Error>` 403
	}

	# Zycord CDN (attachments, avatars, icons, banners, emojis, stickers)
	handle {
		reverse_proxy server:3001
	}
}
