{
	{$CADDY_GLOBAL_OPTIONS}
	servers {
		protocols h1 h2 h3
	}
}

mail.zyron.site, drive.zyron.site, calendar.zyron.site, workspace.zyron.site, book.zyron.site, booking.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	@websockets {
		path /api/realtime /api/realtime/*
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @websockets {
		reverse_proxy zyron-mail:3000 {
			stream_close_delay 5m
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy zyron-mail:3000
	}
}

{$DOMAIN} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	redir /admin https://admin.zyron.site/ permanent
	redir /admin/* https://admin.zyron.site{uri} permanent

	redir /developers/docs https://docs.zyron.site/ permanent
	redir /developers/docs/* https://docs.zyron.site{uri} permanent
	redir /docs https://docs.zyron.site/ permanent
	redir /docs/* https://docs.zyron.site{uri} permanent

	redir /developers https://developers.zyron.site/ permanent
	redir /developers/* https://developers.zyron.site{uri} permanent

	redir /status https://status.zyron.site/ permanent
	redir /status/* https://status.zyron.site{uri} permanent

	@websockets {
		path / /voice /voice/* /remote-auth /remote-auth/*
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @websockets {
		reverse_proxy server:3001 {
			stream_close_delay 5m
		}
	}

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy server:3001
	}
}

docs.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	handle /mintlify-assets/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	@notDocs {
		not path /developers /developers/* /docs /docs/* /api/* /assets/* /branding/* /cdn/* /attachments/* /avatars/* /icons/* /banners/* /favicon.* /_mintlify/* /mintlify-assets/*
	}
	rewrite @notDocs /developers/docs{uri}
	reverse_proxy server:3001
}

developers.zyron.site {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}
	encode zstd gzip

	redir /developers/docs https://docs.zyron.site/ permanent
	redir /developers/docs/* https://docs.zyron.site{uri} permanent
	redir /docs https://docs.zyron.site/ permanent
	redir /docs/* https://docs.zyron.site{uri} permanent
	redir /status https://status.zyron.site/ permanent
	redir /status/* https://status.zyron.site{uri} permanent
	redir /app https://app.zyron.site/app permanent
	redir /app/* https://app.zyron.site{uri} permanent
	redir /login https://app.zyron.site/login?redirect_to=https://developers.zyron.site/developers/applications permanent
	redir /login/* https://app.zyron.site/login?redirect_to=https://developers.zyron.site/developers/applications permanent

	handle /_mintlify/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	handle /mintlify-assets/* {
		reverse_proxy https://docs.discord.com {
			header_up Host docs.discord.com
		}
	}

	@notDev {
		not path /developers /developers/* /api/* /assets/* /branding/* /cdn/* /site/* /media/* /static/* /status /status/*
		not path /attachments/* /avatars/* /icons/* /banners/* /emojis/* /stickers/* /imageproxy/* /favicon.*
		not path /embed/* /badge-icons/* /clan-badges/* /role-icons/* /channel-icons/* /guild-events/* /guild-profiles/* /guild-space/*
		not path /app-assets/* /app-icons/* /soundboard-sounds/* /splashes/* /discovery-splashes/* /discover-splashes/* /profile-effects/*
		not path /_mintlify/* /mintlify-assets/*
		not path *.png *.jpg *.jpeg *.webp *.gif *.svg *.ico *.css *.js *.json *.woff2 *.woff *.ttf
	}
	rewrite @notDev /developers{uri}
	reverse_proxy server:3001
}

